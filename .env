ONNX_EMBEDDING_MODEL="Xenova/all-MiniLM-L12-v2"
ONNX_EMBEDDING_MODEL_PRECISION=fp32
# Model prefixes and pooling are auto-detected by embedding-utils from its registry.
# You generally do not need to configure them manually.
# Only set ONNX_EMBEDDING_MODEL_DOCUMENT_PREFIX / ONNX_EMBEDDING_MODEL_QUERY_PREFIX
# if you need to override the registry default for a specific model.
#
# Prefix override behavior:
#   - Not set (or commented out): embedding-utils uses the registry default for that model
#   - Set to a specific value:    overrides the registry default with your custom prefix
#   - Set to an empty string "":  suppresses the prefix entirely (no prefix applied)
#
# The table below is for reference only. Actual prefix/pooling behavior is
# determined by embedding-utils at runtime based on its built-in model registry.
#
# | Model                                        | Precision | Dimensions | Max Tokens | Size  | Data Prefix | Query Prefix                                         | Pooling     |
# | -------------------------------------------- | --------- | ---------- | ---------- | ----- | ----------- | ---------------------------------------------------- | ----------- |
# | Xenova/all-MiniLM-L6-v2                      | fp32,q8   | 384        | 256        | 22M   | null        | null                                                 | mean        |
# | Xenova/all-MiniLM-L12-v2                     | fp32,q8   | 384        | 256        | 33M   | null        | null                                                 | mean        |
# | Xenova/all-mpnet-base-v2                     | fp32,q8   | 768        | 384        | 109M  | null        | null                                                 | mean        |
# | Xenova/distilroberta-base                    | fp32,q8   | 768        | 512        | 82M   | null        | null                                                 | mean        |
# | Xenova/gte-small                             | fp32,q8   | 384        | 512        | 33M   | null        | null                                                 | mean        |
# | Xenova/gte-base                              | fp32,q8   | 768        | 512        | 109M  | null        | null                                                 | mean        |
# | Xenova/gte-large                             | fp32,q8   | 1024       | 512        | 335M  | null        | null                                                 | mean        |
# | onnx-community/gte-multilingual-base         | fp32,q8   | 768        | 8192       | 305M  | null        | null                                                 | cls         |
# | Xenova/jina-embeddings-v2-small-en           | fp32,q8   | 512        | 8192       | 33M   | null        | null                                                 | mean        |
# | Xenova/jina-embeddings-v2-base-en            | fp32,q8   | 768        | 8192       | 137M  | null        | null                                                 | mean        |
# | Xenova/bge-small-en-v1.5                     | fp32,q8   | 384        | 512        | 33M   | null        | Represent this sentence for searching relevant passages: | cls     |
# | Xenova/bge-base-en-v1.5                      | fp32,q8   | 768        | 512        | 109M  | null        | Represent this sentence for searching relevant passages: | cls     |
# | Xenova/bge-large-en-v1.5                   | fp32,q8   | 1024       | 512        | 335M  | null        | Represent this sentence for searching relevant passages: | cls     |
# | Xenova/bge-m3                                | fp32,q8   | 1024       | 8192       | 568M  | null        | null                                                 | cls         |
# | Xenova/paraphrase-multilingual-MiniLM-L12-v2 | fp32,q8   | 384        | 128        | 118M  | null        | null                                                 | mean        |
# | Xenova/multilingual-MiniLM-L12-v2            | fp32,q8   | 384        | 512        | 33M   | null        | null                                                 | mean        |
# | Xenova/e5-small-v2                           | fp32,q8   | 384        | 512        | 33M   | passage:    | query:                                               | mean        |
# | Xenova/e5-base-v2                            | fp32,q8   | 768        | 512        | 109M  | passage:    | query:                                               | mean        |
# | Xenova/e5-large-v2                           | fp32,q8   | 1024       | 512        | 335M  | passage:    | query:                                               | mean        |
# | Xenova/multilingual-e5-small                 | fp32,q8   | 384        | 512        | 118M  | passage:    | query:                                               | mean        |
# | Xenova/multilingual-e5-base                  | fp32,q8   | 768        | 512        | 278M  | passage:    | query:                                               | mean        |
# | Xenova/multilingual-e5-large                 | fp32,q8   | 1024       | 512        | 560M  | passage:    | query:                                               | mean        |
# | nomic-ai/nomic-embed-text-v1.5               | fp32,q8   | 768        | 8192       | 137M  | search_document: | search_query:                                    | mean        |
# | mixedbread-ai/mxbai-embed-large-v1           | fp32,q8   | 1024       | 512        | 335M  | null        | Represent this sentence for searching relevant passages: | cls   |
# | Snowflake/snowflake-arctic-embed-m-v1.5      | fp32,q8   | 768        | 512        | 109M  | null        | Represent this sentence for searching relevant passages: | cls   |
# | Snowflake/snowflake-arctic-embed-l           | fp32,q8   | 1024       | 512        | 335M  | null        | Represent this sentence for searching relevant passages: | cls   |
# | onnx-community/Qwen3-Embedding-0.6B-ONNX     | fp32,q8   | 1024       | 32768      | 595M  | null        | Instruct: Given a web search query...                | last_token  |
#
# Notes:
# - fp16 is supported for most models but not listed above for brevity
# - Models > 2GB in fp32 (multilingual-e5-large, bge-m3, Qwen3) recommend q8/fp16
# - "null" prefix means no prefix is applied for that input type

ALLOW_REMOTE_MODELS=true
LOCAL_MODEL_PATH=models/
CACHE_DIR=models/

# Clustering Configuration
ENABLE_CLUSTERING=true
CLUSTERING_ALGORITHM=default
CLUSTERING_SIMILARITY_THRESHOLD=0.9
CLUSTERING_MIN_CLUSTER_SIZE=5
CLUSTERING_MAX_CLUSTERS=5
